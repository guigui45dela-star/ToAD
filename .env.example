# ============================================================================
# ToAD - Configuration de l'Environnement
# ============================================================================
# 
# ⚠️  IMPORTANT : Ce fichier contient des informations sensibles
# 
# 1. Copiez ce fichier vers .env : cp .env.example .env
# 2. Modifiez les valeurs avec des mots de passe SÉCURISÉS
# 3. Restreignez les permissions : chmod 600 .env
# 4. Ne commitez JAMAIS le fichier .env dans Git
# 
# 📖 Documentation : docs/security-configuration.md
# ============================================================================

# ============================================================================
# 🔐 AUTHENTIFICATION API (OBLIGATOIRE)
# ============================================================================
# 
# Le token API protège tous les endpoints de l'API ToAD.
# Sans token, l'API retournera une erreur 401 Unauthorized.
# 
# Génération d'un token sécurisé :
#   openssl rand -hex 32
# 
# Ou avec Python :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# 
# Utilisation avec curl :
#   curl -H "Authorization: Bearer VOTRE_TOKEN" http://localhost:9100/api/audits
# 
# ⚠️  LEGACY : Ce token est conservé pour compatibilité ascendante.
#    Le système d'authentification principal utilise désormais JWT (voir ci-dessous).
# 
API_TOKEN=change-me-to-a-64-characters-hex-token-generated-with-openssl

# ============================================================================
# 🔑 AUTHENTIFICATION JWT ET GESTION DES UTILISATEURS
# ============================================================================
# 
# ToAD utilise un système d'authentification par JWT avec gestion d'utilisateurs
# et rôles (admin, user, viewer).
# 
# --- JWT_SECRET (OBLIGATOIRE) ---
# Clé secrète pour signer les tokens JWT.
# Génération :
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# 
JWT_SECRET=change-me-to-a-64-characters-hex-token-for-jwt

# --- JWT_EXPIRATION_HOURS ---
# Durée de validité des tokens JWT en heures (défaut : 24).
# JWT_EXPIRATION_HOURS=24

# --- ADMIN_DEFAULT_USERNAME ---
# Nom d'utilisateur de l'admin créé au premier démarrage (défaut : admin).
# ADMIN_DEFAULT_USERNAME=admin

# --- ADMIN_DEFAULT_PASSWORD ---
# Mot de passe de l'admin créé au premier démarrage.
# ⚠️  CHANGEZ-LE immédiatement après la première connexion !
# Si non défini, le mot de passe par défaut est "admin".
# ADMIN_DEFAULT_PASSWORD=change-me-to-a-secure-password

# --- Rôles et permissions ---
# admin  : Tous les droits (gestion utilisateurs, audits, configuration)
# user   : Créer/modifier/supprimer des audits et clients
# viewer : Lecture seule (voir les audits, télécharger les rapports)
# 
# --- Endpoints d'authentification ---
# POST /api/auth/login          : Obtenir un token JWT
# POST /api/auth/logout         : Déconnexion
# GET  /api/auth/me             : Infos utilisateur courant
# GET  /api/users               : Lister les utilisateurs (admin)
# POST /api/users               : Créer un utilisateur (admin)
# PUT  /api/users/{id}          : Modifier un utilisateur (admin)
# DELETE /api/users/{id}        : Supprimer un utilisateur (admin)
# POST /api/users/{id}/reset-password : Réinitialiser mot de passe (admin)
# 
# --- Exemple de connexion ---
# curl -X POST http://localhost:9100/api/auth/login \
#   -H "Content-Type: application/json" \
#   -d '{"username": "admin", "password": "mon-mot-de-passe"}'
# 
# curl -H "Authorization: Bearer <token_retourne>" http://localhost:9100/api/audits
#

# ============================================================================
# 🎯 MODE BLOODHOUND
# ============================================================================
# 
# Mode local (recommandé pour débuter) :
#   - BloodHound CE, PostgreSQL et Neo4j sont déployés automatiquement
#   - Configuration simplifiée
#   - Parfait pour un usage standalone
# 
# Mode remote (pour infrastructure existante) :
#   - Connexion à une instance BloodHound existante
#   - Nécessite de configurer les URLs et identifiants ci-dessous
# 
BLOODHOUND_MODE=local

# ============================================================================
# 🌐 CONFIGURATION TOAD
# ============================================================================

# Port d'écoute de l'application web
# ⚠️ Ne pas exposer directement sur Internet, utilisez un reverse proxy
TOAD_PORT=9100

# Fuseau horaire
# Liste : https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Paris

# ============================================================================
# 🏠 CONFIGURATION BLOODHOUND (MODE LOCAL)
# ============================================================================
# 
# Ces variables sont utilisées uniquement quand BLOODHOUND_MODE=local
# Elles configurent les conteneurs Docker BloodHound, PostgreSQL et Neo4j
# 

# ----------------------------------------------------------------------------
# BloodHound CE
# ----------------------------------------------------------------------------

# Port BloodHound (accessible depuis le host)
# ⚠️ En production, exposez uniquement via reverse proxy avec HTTPS
BLOODHOUND_PORT=8080

# Identifiants administrateur BloodHound
# ⚠️ CHANGEZ CES VALEURS ! N'utilisez jamais les valeurs par défaut
# 
# Génération de mot de passe sécurisé :
#   openssl rand -base64 32
# 
BLOODHOUND_USERNAME=admin
BLOODHOUND_PASSWORD=change-me-to-a-secure-password-min-32-chars

# ----------------------------------------------------------------------------
# PostgreSQL (Base de données BloodHound)
# ----------------------------------------------------------------------------

# Identifiants PostgreSQL
# ⚠️ CHANGEZ CES VALEURS !
POSTGRES_USER=bloodhound
POSTGRES_PASSWORD=change-me-to-a-secure-password-min-32-chars
POSTGRES_DB=bloodhound

# ----------------------------------------------------------------------------
# Neo4j (Base de données graphe)
# ----------------------------------------------------------------------------

# Identifiants Neo4j
# ⚠️ CHANGEZ CES VALEURS !
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-to-a-secure-password-min-32-chars

# Permettre la mise à jour automatique de Neo4j (recommandé)
NEO4J_ALLOW_UPGRADE=true

# Ports Neo4j (accessibles depuis le host)
# ⚠️ En production, ne pas exposer ces ports directement
NEO4J_WEB_PORT=7474
NEO4J_DB_PORT=7687

# ============================================================================
# 🌍 CONFIGURATION BLOODHOUND (MODE REMOTE)
# ============================================================================
# 
# Ces variables sont utilisées uniquement quand BLOODHOUND_MODE=remote
# Décommentez et configurez si vous utilisez une instance BloodHound existante
# 

# URL de l'API BloodHound
# Exemples :
#   http://bloodhound.internal:8080
#   https://bloodhound.example.com
# BLOODHOUND_URL=http://your-bloodhound-host:8080

# Identifiants BloodHound
# BLOODHOUND_USERNAME=admin
# BLOODHOUND_PASSWORD=your-secure-password

# URL Neo4j (protocole Bolt)
# Exemples :
#   bolt://neo4j.internal:7687
#   bolt://neo4j.example.com:7687
# NEO4J_URL=bolt://your-neo4j-host:7687

# Identifiants Neo4j
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-secure-password

# ============================================================================
# ⚙️ CONFIGURATION AD-MINER
# ============================================================================

# Temps d'attente pour l'ingestion BloodHound (en secondes)
# 
# AD-Miner attend que BloodHound termine l'ingestion des données SharpHound
# avant de générer le rapport. Augmentez cette valeur si :
#   - Vous avez de gros fichiers SharpHound (>100MB)
#   - Votre serveur est lent
#   - Vous rencontrez des erreurs "Neo4j not ready"
# 
# Valeurs recommandées :
#   - Petit fichier (<50MB) : 30 secondes
#   - Moyen fichier (50-200MB) : 60 secondes
#   - Gros fichier (>200MB) : 120 secondes
# 
INGEST_WAIT_SECONDS=30

# ============================================================================
# 🔒 SÉCURITÉ ET RATE LIMITING
# ============================================================================
# 
# Configuration du rate limiting pour prévenir les abus
# 

# Nombre maximum de requêtes par minute par IP
# Valeur par défaut : 120
# RATE_LIMIT_MAX=120

# Fenêtre de temps pour le rate limiting (en secondes)
# Valeur par défaut : 60
# RATE_LIMIT_WINDOW=60

# ============================================================================
# 📊 LOGGING ET MONITORING
# ============================================================================

# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Valeur par défaut : INFO
# LOG_LEVEL=INFO

# ============================================================================
# 🧪 CONFIGURATION AVANCÉE
# ============================================================================

# Nombre maximum de workers pour le thread pool
# Augmentez si vous avez beaucoup de générations AD-Miner simultanées
# Valeur par défaut : 3
# MAX_WORKERS=3

# Taille maximale des fichiers uploadés (en bytes)
# Valeurs par défaut :
#   - PingCastle : 50 MB (52428800 bytes)
#   - SharpHound : 500 MB (526240000 bytes)
# MAX_PINGCASTLE_SIZE=52428800
# MAX_SHARPHOUND_SIZE=526240000

# ============================================================================
# 📝 NOTES ET BONNES PRATIQUES
# ============================================================================
# 
# 1. SÉCURITÉ DES MOTS DE PASSE
#    - Utilisez des mots de passe d'au moins 32 caractères
#    - Mélangez lettres majuscules/minuscules, chiffres et symboles
#    - Ne réutilisez jamais les mêmes mots de passe
#    - Rotations régulières (tous les 90 jours)
# 
# 2. PROTECTION DU FICHIER .env
#    - chmod 600 .env (lecture/écriture uniquement pour le propriétaire)
#    - Ne jamais commiter dans Git
#    - Sauvegarde sécurisée (chiffrée)
# 
# 3. DÉPLOIEMENT EN PRODUCTION
#    - Utilisez toujours HTTPS (reverse proxy avec Let's Encrypt)
#    - Configurez un firewall restrictif (UFW, iptables)
#    - Ne pas exposer les ports internes (8080, 7474, 7687)
#    - Activez Fail2Ban pour prévenir les attaques brute-force
#    - Consultez docs/deployment-security.md
# 
# 4. BACKUP RÉGULIER
#    - Backup quotidien des données clients
#    - Backup hebdomadaire des bases de données
#    - Testez régulièrement la restauration
# 
# 5. MISE À JOUR
#    - Gardez ToAD à jour
#    - Testez les mises à jour en environnement de test
#    - Consultez le CHANGELOG.md avant chaque mise à jour
# 
