# ============================================================================
# ToAD - Configuration
# ============================================================================
# Ce fichier est généré automatiquement par le setup web (/setup)
# Ne modifiez ce fichier manuellement que si vous savez ce que vous faites
# ============================================================================

# Mode BloodHound : local (docker-compose all-in-one) ou remote (instance externe)
BLOODHOUND_MODE=local

# ============================================================================
# Configuration ToAD
# ============================================================================

# Port d'écoute de l'application web
TOAD_PORT=9100

# Fuseau horaire
TZ=Europe/Paris

# ============================================================================
# Configuration BloodHound (mode local)
# ============================================================================

# Ces variables sont utilisées quand BLOODHOUND_MODE=local
# Elles configurent les conteneurs BloodHound, PostgreSQL et Neo4j

# Port BloodHound (accessible depuis le host)
BLOODHOUND_PORT=8080

# Identifiants administrateur BloodHound
BLOODHOUND_USERNAME=admin
BLOODHOUND_PASSWORD=change-me-to-a-secure-password

# Configuration PostgreSQL
POSTGRES_USER=bloodhound
POSTGRES_PASSWORD=change-me-to-another-secure-password
POSTGRES_DB=bloodhound

# Configuration Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-to-a-third-secure-password

# Permettre la mise à jour Neo4j (recommandé)
NEO4J_ALLOW_UPGRADE=true

# Ports Neo4j (accessibles depuis le host)
NEO4J_WEB_PORT=7474
NEO4J_DB_PORT=7687

# ============================================================================
# Configuration BloodHound (mode remote)
# ============================================================================

# Ces variables sont utilisées quand BLOODHOUND_MODE=remote
# Elles pointent vers une instance BloodHound existante

# URL de l'API BloodHound (ex: http://bloodhound.example.com:8080)
# BLOODHOUND_URL=http://your-bloodhound-host:8080

# Identifiants BloodHound
# BLOODHOUND_USERNAME=admin
# BLOODHOUND_PASSWORD=your-password

# URL Neo4j (protocol Bolt)
# NEO4J_URL=bolt://your-neo4j-host:7687

# Identifiants Neo4j
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password

# ============================================================================
# Configuration AD-Miner
# ============================================================================

# Temps d'attente pour l'ingestion BloodHound (en secondes)
# Augmentez si vous avez de gros fichiers SharpHound
INGEST_WAIT_SECONDS=30

# ============================================================================
# Authentification (optionnel mais recommandé)
# ============================================================================

# Pour activer l'authentification Basic Auth, décommentez et configurez
# Voir docs/security.md pour plus d'informations
# AUTH_ENABLED=true
# AUTH_USERNAME=admin
# AUTH_PASSWORD=your-secure-password
